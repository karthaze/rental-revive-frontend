# ============================================================
# RentalRevive — client env manifest
# ------------------------------------------------------------
# Copy to `.env.local` and fill in. Only VITE_* vars are read by
# the browser build, and everything here is PUBLIC by design —
# it ships in the bundle. No provider secret belongs in this
# file (see AD-13 at the bottom).
#
# Vite loads env from this directory, not `frontend/` — see the
# `envDir` note in vite.config.js and the guard in
# vite.config.test.mjs. Every var below fails *quietly* when
# unset, so an empty value means a silently degraded app, not
# an error.
# ============================================================

# The Revive Agent backend (services/convex/). Doubles as the
# build-time switch for the proof gate: with this unset,
# probeConfigured() folds to false and Vite dead-code-eliminates
# the gate and dashboard entirely (dist/assets/gate-*.js drops to
# ~114 bytes). The scan itself runs fine without it.
VITE_CONVEX_URL=

# Clerk auth for the dashboard. Needs a JWT template named
# `convex`, and the Clerk issuer configured in Convex's auth
# settings. Publishable key only — never the secret key.
VITE_CLERK_PUBLISHABLE_KEY=

# Google Maps JS API key — powers yard search, lock-on and the
# competitor radar (frontend/src/onboard/places.js). Unset means
# mapsUp() is false: the search box shows no suggestions, the
# radar step is skipped, and the scan falls back to a typed
# business name. Degrades silently, which is why the second test
# in vite.config.test.mjs asserts this reaches .env.local.
# VITE_MAPS_API_KEY is accepted as an alias (VOLTBOT parity).
VITE_GOOGLE_MAPS_KEY=AIzaSyBRTXsVhpP8CtsRTqDFFWgkrQPxes4X1jY

# Where the landing-page email capture and the scan's send-form
# POST the report request. Unset means the form no-ops.
VITE_AUDIT_ENDPOINT=

# ------------------------------------------------------------
# DELIBERATELY ABSENT — do not re-add
# ------------------------------------------------------------
# VITE_APIFY_TOKEN and VITE_THUM_IO_KEY used to live here and
# leaked into the client bundle. AD-13 moved enrichment server-
# side to services/convex/enrichment/, behind the APIFY_TOKEN and
# THUM_IO_KEY *Convex* env vars (npx convex env set). No provider
# endpoint should appear in either build — grep dist/ if unsure.
# The full server-side var list is in SESSION.md §5.
