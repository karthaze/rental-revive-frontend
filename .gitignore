# Env files stay local, including the .env.example manifest.
.env
.env.example
.env.local
.env.*.local

# Project-local Python venv holding the graphify CLI (machine-specific;
# the hooks in .claude/settings.json reference it by absolute path).
.venv/

# graphify build output (regenerate with /graphify .)
graphify-out/

# Rendered pages. Source of truth is frontend/pages/ + frontend/templates/
# (and common/segments.js, via build/yards.mjs). `npm run render` composes
# them into frontend/ as Vite MPA entry points. Edit the sources — anything
# matched here is overwritten on every build.
#
# Inverted on purpose: ignore every root-level .html and re-admit the three
# that are still hand-written. Listing generated pages individually meant
# every new page needed a new line here, and the one nobody remembered got
# committed as source.
frontend/*.html
!frontend/onboard.html
!frontend/privacy.html
!frontend/terms.html
# Generated directories:
frontend/the-leak/
frontend/yards/
frontend/pages/yards/
.gstack/
