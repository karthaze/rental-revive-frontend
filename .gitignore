# Env files stay local, including the .env.example manifest.
.env
.env.example
.env.local
.env.*.local

# Project-local Python venv holding the graphify CLI (machine-specific;
# the hooks in .claude/settings.json reference it by absolute path).
.venv/

# graphify build output (regenerate with /graphify .)
graphify-out/

# Rendered pages. Source of truth is frontend/pages/ + frontend/templates/;
# `npm run render` composes them into frontend/ as Vite MPA entry points.
# Edit the sources — anything listed here is overwritten on every build.
# Whole directories are generated:
frontend/the-leak/
frontend/catch/
frontend/quote/
frontend/recover/
frontend/run/
frontend/yards/
# Root-level generated pages, listed individually because onboard.html,
# privacy.html and terms.html are still hand-written:
frontend/heydozr.html
frontend/index.html
.gstack/
